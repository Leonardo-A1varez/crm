# Plantilla de variables de entorno. Copiar a .env.local y rellenar.
# Las claves reales se conectan recién en fases 9-12. Hasta entonces vacías.

# ─────────────────────────────────────────────
# Supabase (Fase 9 — DB + Auth + Storage + Realtime)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# Inngest (Fase 10 — workflows + cola + cron)
# ─────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─────────────────────────────────────────────
# OpenAI (Fase 11 — agente IA seller via Vercel AI SDK / @ai-sdk/openai)
# ─────────────────────────────────────────────
OPENAI_API_KEY=

# AI Gateway (opcional, post-fase 11 cuando volumen real lo justifique)
# AI_GATEWAY_API_KEY=

# ─────────────────────────────────────────────
# Meta Cloud API (Fase 12 — WhatsApp + IG + FB)
# ─────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# IG + FB Messenger (opcionales pilot — WA-only puede arrancar sin estos).
# IG: IG Business Account ID + Page Access Token (Graph API Explorer).
# FB: FB Page ID + Page Access Token.
# Si missing, sendText({canal:"ig"|"fb"}) throws ValidationError fail-fast.
META_IG_PAGE_ID=
META_IG_ACCESS_TOKEN=
META_FB_PAGE_ID=
META_FB_PAGE_ACCESS_TOKEN=

# ─────────────────────────────────────────────
# LLM cost guard (kill switch daily cap USD)
# Dev: 5  ·  Preview: 20  ·  Prod: 100 (ajustar según volumen real)
# ─────────────────────────────────────────────
LLM_DAILY_CAP_USD=10

# LLM mode (Slice 1 7.7.A — DI factory).
#   real → OpenAI impls (requiere OPENAI_API_KEY válida).
#   mock → InMemory impls (responses deterministic, sin tokens — staging/CI).
# Default prod: real. Tests Vitest: forzado mock vía testEnvSchema.
LLM_MODE=real

# ─────────────────────────────────────────────
# Upstash Redis (B3 — rate limit webhook Meta + futuro cost-tracker prod)
# Free tier 10K cmds/día gratis. Dev opcional (NoopRateLimiter fallback).
# Prod obligatorio.
# Create: https://upstash.com/ → Redis → REST API
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────
# Integration tests (Slice 1 7.4+) — Supabase real (proyecto dev SOLAMENTE)
# Apuntar al mismo crm-dev linked. NUNCA prod.
# Local-only: NO commitear con secrets. CI separate workflow con masked secrets.
# ─────────────────────────────────────────────
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=
