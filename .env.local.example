# Plantilla de variables de entorno. Copiar a .env.local y rellenar.
# Las claves reales se conectan recién en fases 9-12. Hasta entonces vacías.

# ─────────────────────────────────────────────
# Supabase (Fase 9 — DB + Auth + Storage + Realtime)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# Inngest (Fase 10 — workflows + cola + cron)
# ─────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Modo dev del SDK: rutea inngest.send() al dev server local (localhost:8288)
# en vez de Inngest Cloud. OBLIGATORIO en local — NODE_ENV=development no alcanza:
# con INNGEST_EVENT_KEY seteada el SDK asume cloud, la key dummy da 401 y el
# webhook de Meta responde 500. En Vercel dejarla vacía y usar las keys reales.
# INNGEST_DEV=1

# ─────────────────────────────────────────────
# OpenAI (Fase 11 — agente IA seller via Vercel AI SDK / @ai-sdk/openai)
# ─────────────────────────────────────────────
OPENAI_API_KEY=

# Modelo por workflow. OPENAI_MODEL es el default de los 4 LLM auxiliares; los
# _<WORKFLOW> lo pisan individualmente. Vacío → gpt-4o-mini (DEFAULT_OPENAI_MODEL).
# Todo modelo debe existir en src/server/services/llm/pricing.ts o la app no
# arranca (ValidationError al construir el factory).
#
# El split existe porque las exigencias difieren: clasificador, extractor,
# resumidor y batch-detector solo llenan un schema (modelo barato alcanza).
# Poner un modelo caro ahí rinde de menos de lo que cuesta.
#
# Ojo con la familia gpt-5*: son de razonamiento y los reasoning tokens se
# facturan como output sin aparecer en la respuesta. Medir antes de migrar.
# OPENAI_MODEL=gpt-4o-mini
# DEPRECADA: el modelo del agente ya no sale de acá, se configura en /agente
# (tabla agente_config). Seguir seteando esta var no tiene ningún efecto.
# OPENAI_MODEL_AGENT=
# OPENAI_MODEL_CLASSIFIER=
# OPENAI_MODEL_TWIN=
# OPENAI_MODEL_SUMMARIZER=
# OPENAI_MODEL_BATCH=

# AI Gateway (opcional, post-fase 11 cuando volumen real lo justifique)
# AI_GATEWAY_API_KEY=

# ─────────────────────────────────────────────
# Meta Cloud API (Fase 12 — WhatsApp + IG + FB)
# ─────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# IG + FB Messenger (opcionales pilot — WA-only puede arrancar sin estos).
# IG: IG Business Account ID + Page Access Token (Graph API Explorer).
# FB: FB Page ID + Page Access Token.
# Si missing, sendText({canal:"ig"|"fb"}) throws ValidationError fail-fast.
META_IG_PAGE_ID=
META_IG_ACCESS_TOKEN=
META_FB_PAGE_ID=
META_FB_PAGE_ACCESS_TOKEN=

# ─────────────────────────────────────────────
# LLM cost guard (kill switch daily cap USD)
# Dev: 5  ·  Preview: 20  ·  Prod: 100 (ajustar según volumen real)
# ─────────────────────────────────────────────
LLM_DAILY_CAP_USD=10

# LLM mode (Slice 1 7.7.A — DI factory).
#   real → OpenAI impls (requiere OPENAI_API_KEY válida).
#   mock → InMemory impls (responses deterministic, sin tokens — staging/CI).
# Default prod: real. Tests Vitest: forzado mock vía testEnvSchema.
LLM_MODE=real

# ─────────────────────────────────────────────
# Upstash Redis (B3 — rate limit webhook Meta + futuro cost-tracker prod)
# Free tier 10K cmds/día gratis. Dev opcional (NoopRateLimiter fallback).
# Prod obligatorio.
# Create: https://upstash.com/ → Redis → REST API
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────
# Integration tests — Supabase real, proyecto EXCLUSIVO de pruebas.
# NUNCA apuntar a crm-dev ni producción: la suite ejecuta TRUNCATE durante el
# setup. Crear y migrar un proyecto separado antes de completar estas vars.
# Local-only: NO commitear con secrets. CI usa secrets masked propios.
# ─────────────────────────────────────────────
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=
